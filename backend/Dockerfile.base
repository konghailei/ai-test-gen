# ============================================================================
# AI-Test-Gen 基础镜像
# 
# 含全部 Python 依赖 + bge 模型，构建一次，日常不重建。
# 构建命令：docker compose -f docker-compose.base.yml build base
# ============================================================================
FROM python:3.12-slim

WORKDIR /app

# 系统依赖 + Python 依赖（合并为一层，减少镜像体积）
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && mkdir -p /app/data

# 直接内置本地 bge 模型：构建前已下载到项目 models/ 目录，
# 构建时 COPY 进镜像，运行时零下载（替代原来的 modelscope 在线下载）。
# 模型约 1.3GB，请确保 models/bge-large-zh-v1.5 已就绪后再执行本构建。
COPY models/bge-large-zh-v1.5 /app/models/bge-large-zh-v1.5
ENV EMBEDDING_MODEL_TYPE=local \
    EMBEDDING_MODEL_NAME=/app/models/bge-large-zh-v1.5 \
    EMBEDDING_DEVICE=cpu

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
