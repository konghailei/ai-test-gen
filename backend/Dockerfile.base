# ============================================================================
# AI-Test-Gen 基础镜像
#
# 含全部 Python 依赖。默认**在线安装**（`pip install -r requirements.txt`），
# 重复构建由 Docker 层缓存加速；无需（也不再支持）预先下载轮子缓存。
#
# 构建命令：docker compose -f docker-compose.base.yml build base
#
# 注：bge 模型（嵌入 / 重排）通过 docker-compose.yml 的 bind mount
# 从宿主机 ./models 挂载进容器，不烘焙进镜像，因此本镜像不再 COPY 模型目录。
# 模型需预先下载到 ./models（见 README 的「下载本地模型」章节）。
# ============================================================================
FROM python:3.12-slim

WORKDIR /app

# 复制依赖清单并在线安装（无需本地轮子缓存；Docker 层缓存加速重复构建）
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && mkdir -p /app/data

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
