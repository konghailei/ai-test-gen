# ======================================================================
# AI-Test-Gen 环境变量配置模板
# ======================================================================
# 
# 用法：复制本文件为 .env，填入实际值
#   cp .env.example .env
#
# 设计依据：
# - docs/05-technical-selection.md §2（LLM 提供商选型）
# - docs/05-technical-selection.md §4（向量数据库选型）
# - docs/02-knowledge-base.md §2.5（知识库配置）
# - docs/05-technical-selection.md §11（限流配置）
#
# 技术栈（docs/05 §8.1）：
#   PostgreSQL + pgvector + Milvus + Redis + Celery（统一架构，无 SQLite）
# ======================================================================

# ======================================================================
# LLM 配置
# ======================================================================
# LLM 提供商：deepseek（主力，成本低）| openai（备用）
LLM_PROVIDER=deepseek

# DeepSeek API（主力，OpenAI 兼容接口）
# 成本约 GPT-4o 的 1/5，中文效果相当（docs/05 §2.2）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API（备用，故障转移）
# 仅在 DeepSeek 不可用或高复杂度需求时使用（docs/05 §2.2）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ======================================================================
# 数据库配置（PostgreSQL + pgvector，系统唯一关系数据库后端）
# ======================================================================
# 数据目录（存放日志、密钥等持久化文件，相对 backend 目录）
DATA_DIR=./data

# PostgreSQL 连接字符串（必填）
DATABASE_URL=postgresql://aitestgen:aitestgen123@localhost:5432/ai_test_gen
PG_POOL_SIZE=10
PG_TIMEOUT=30

# 向量库（Milvus）由 docker-compose 的 milvus/etcd/minio 服务托管，无需本地路径配置

# ======================================================================
# 嵌入模型配置
# ======================================================================
# Embedding 模型（docs/05 §5）：本地 sentence-transformers（中文优化，已内置基础镜像）。
# 加载方式由 EMBEDDING_MODEL_NAME 决定（绝对路径=本地目录，否则按模型 ID 下载），无 type 开关。
# 方式一（已下载到本地，推荐，零联网）：
#   Docker 基础镜像内置路径  ->  /app/models/bge-large-zh-v1.5
#   宿主机本地路径（示例）   ->  D:/git_down/ai-test-gen/models/bge-large-zh-v1.5
# 方式二（未下载）：填 HuggingFace 模型 ID，首次运行自动下载并缓存
#   BAAI/bge-large-zh-v1.5（中文）| BAAI/bge-m3（多语言）
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu              # cpu | cuda | mps

# ======================================================================
# 检索配置（docs/02 §3）
# ======================================================================
MATCH_FINAL_N=5                   # 最终返回数量（召回数由各调用方 top_k 参数决定）

# ======================================================================
# 质量门禁配置
# ======================================================================
# 正常模式通过阈值（docs/01 §5.2）
DEFAULT_PASS_SCORE=0.75
# 冷启动模式通过阈值（KB 为空时放宽，避免死锁）
COLD_START_PASS_SCORE=0.60
# ClarifyAgent 最大迭代轮次（防止死循环）
MAX_CLARIFY_ITERATIONS=3

# ======================================================================
# 服务配置
# ======================================================================
APP_PORT=8000
FRONTEND_URL=http://localhost:5173   # 前端开发服务地址（CORS 白名单）
DEBUG=true

# ======================================================================
# 安全配置
# ======================================================================

# JWT 签名密钥 — 生产环境必填（DEBUG=False 时强制）
# 开发环境未设置时会自动生成临时密钥（重启后 JWT 失效）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_SECRET_KEY=your_random_secret_key_here

# Fernet 主密钥 — 用于加密数据库中存储的 LLM API Key
# 
# 优先级：
#   1. 环境变量 MASTER_KEY（最高优先级，生产推荐）
#   2. 密钥文件 ./data/.keys/master.key（持久卷保留，内网适用）
#   3. 固定派生密钥（内网/开发兜底，确定性生成）
#
# 安全策略：
#   - 生产环境（DEBUG=False）：必须设置 MASTER_KEY，否则拒绝启动
#   - 内网/开发（DEBUG=True）：未设置时使用固定派生密钥 + 密钥文件持久化
#   - 不同环境/实例如需共享加密数据，必须设置相同的 MASTER_KEY
#
# 生成新密钥（任意选一个使用 Fernet 的方式）：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# 重要提醒：
#   - 丢失 MASTER_KEY = 永久无法解密已存储的 API Key，必须重新配置
#   - 多实例部署（负载均衡）必须使用相同 MASTER_KEY
# MASTER_KEY=your_fernet_master_key_here

# 默认管理员初始密码 — 仅在首次启动 users 表为空时生效（可登录后通过系统设置修改）
# DEFAULT_ADMIN_PASSWORD=your_admin_password_here

# ======================================================================
# Redis 配置（限速/断路器/缓存/DLQ，L1 语义缓存）
# ======================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 限流配置（docs/05 §11.2）
# API_RPM_LIMIT=60                # 业务接口每分钟额度（按真实客户端 IP 分桶）
# API_RATE_WINDOW=60              # 限流窗口（秒）

# ======================================================================
# Celery 配置（异步任务队列，嵌入向量计算 + 知识库双写）
# ======================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ======================================================================
# 可观测性配置（LangFuse 全链路追踪，docs/05 §7）
# ======================================================================
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
