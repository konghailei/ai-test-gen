# ======================================================================
# AI-Test-Gen 环境变量配置模板
# ======================================================================
# 
# 用法：复制本文件为 .env，填入实际值
#   cp .env.example .env
#
# 设计依据：
# - docs/05-technical-selection.md §2（LLM 提供商选型）
# - docs/05-technical-selection.md §4（向量数据库选型）
# - docs/02-knowledge-base.md §2.5（知识库配置）
# - docs/05-technical-selection.md §11（限流配置）
#
# 迁移路径（docs/05 §8.1）：
#   开发阶段 → SQLite + ChromaDB 嵌入式（无需外部服务）
#   生产阶段 → PostgreSQL+pgvector + Redis + ChromaDB独立/Milvus
# ======================================================================

# ======================================================================
# LLM 配置
# ======================================================================
# LLM 提供商：deepseek（主力，成本低）| openai（备用）
LLM_PROVIDER=deepseek

# DeepSeek API（主力，OpenAI 兼容接口）
# 成本约 GPT-4o 的 1/5，中文效果相当（docs/05 §2.2）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API（备用，故障转移）
# 仅在 DeepSeek 不可用或高复杂度需求时使用（docs/05 §2.2）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ======================================================================
# MVP 数据库配置（SQLite + ChromaDB 嵌入式，零外部依赖）
# ======================================================================
# SQLite 数据库文件路径（相对 backend 目录）
SQLITE_PATH=./data/aitestgen.db

# ChromaDB 向量库持久化路径
CHROMA_PATH=./data/chroma

# ======================================================================
# 生产数据库配置（PostgreSQL + pgvector）
# 迁移条件：ChromaDB 检索 P95 > 200ms（docs/02 §9.1）
# 取消注释后生效，需同时将 SQLITE_PATH 注释掉
# ======================================================================
# DATABASE_URL=postgresql://aitestgen:password@localhost:5432/ai_test_gen
# PG_POOL_SIZE=10
# PG_TIMEOUT=30

# ======================================================================
# 嵌入模型配置
# ======================================================================
# Embedding 模型类型（docs/05 §5）：
#   chroma_default - ChromaDB 内置 ONNX all-MiniLM-L6-v2（英文优化，零配置）
#   local          - 本地 sentence-transformers 模型（中文优化，推荐，已内置基础镜像）
EMBEDDING_MODEL_TYPE=local

# 仅 EMBEDDING_MODEL_TYPE=local 时生效。二选一：
# 方式一（已下载到本地，推荐，零联网）：
#   Docker 基础镜像内置路径  ->  /app/models/bge-large-zh-v1.5
#   宿主机本地路径（示例）   ->  D:/git_down/ai-test-gen/models/bge-large-zh-v1.5
# 方式二（未下载）：填 HuggingFace 模型 ID，首次运行自动下载并缓存
#   BAAI/bge-large-zh-v1.5（中文）| BAAI/bge-m3（多语言）
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu              # cpu | cuda | mps

# ======================================================================
# 知识库维护配置（docs/02 §2.5）
# ======================================================================
KB_DECAY_RATE=0.005               # 时间衰减率（半衰期 ~180 天）
KB_BOOST_REUSE=1.5                # 复用加分系数
KB_MIN_WEIGHT=0.1                 # 最低权重（防止完全遗忘）
KB_CLEANUP_DAYS=365               # 超过 365 天未使用的知识自动归档

# ======================================================================
# 检索配置（docs/02 §3）
# ======================================================================
MATCH_TOP_K=20                    # 召回数量
MATCH_FINAL_N=5                   # 最终返回数量
MATCH_SIMILARITY_THRESHOLD=0.70   # 最低相似度阈值
MATCH_ENABLE_RRF=true             # 是否启用 RRF 融合
MATCH_ENABLE_GRAPH=false          # 是否启用图谱扩展（需要 Neo4j/networkx）

# ======================================================================
# 质量门禁配置
# ======================================================================
# 正常模式通过阈值（docs/01 §5.2）
DEFAULT_PASS_SCORE=0.75
# 冷启动模式通过阈值（KB 为空时放宽，避免死锁）
COLD_START_PASS_SCORE=0.60
# ClarifyAgent 最大迭代轮次（防止死循环）
MAX_CLARIFY_ITERATIONS=3

# ======================================================================
# 服务配置
# ======================================================================
APP_PORT=8000
FRONTEND_URL=http://localhost:5173   # 前端开发服务地址（CORS 白名单）
DEBUG=true

# ======================================================================
# 安全配置
# ======================================================================

# JWT 签名密钥 — 生产环境必填（DEBUG=False 时强制）
# 开发环境未设置时会自动生成临时密钥（重启后 JWT 失效）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_SECRET_KEY=your_random_secret_key_here

# Fernet 主密钥 — 用于加密数据库中存储的 LLM API Key
# 
# 优先级：
#   1. 环境变量 MASTER_KEY（最高优先级，生产推荐）
#   2. 密钥文件 ./data/.keys/master.key（持久卷保留，内网适用）
#   3. 固定派生密钥（内网/开发兜底，确定性生成）
#
# 安全策略：
#   - 生产环境（DEBUG=False）：必须设置 MASTER_KEY，否则拒绝启动
#   - 内网/开发（DEBUG=True）：未设置时使用固定派生密钥 + 密钥文件持久化
#   - 不同环境/实例如需共享加密数据，必须设置相同的 MASTER_KEY
#
# 生成新密钥（任意选一个使用 Fernet 的方式）：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# 重要提醒：
#   - 丢失 MASTER_KEY = 永久无法解密已存储的 API Key，必须重新配置
#   - 多实例部署（负载均衡）必须使用相同 MASTER_KEY
# MASTER_KEY=your_fernet_master_key_here

# 默认管理员初始密码 — 仅在首次启动 users 表为空时生效（可登录后通过系统设置修改）
# DEFAULT_ADMIN_PASSWORD=your_admin_password_here

# ======================================================================
# Redis 配置（生产环境，限速/断路器/缓存/DLQ）
# 取消注释后生效（docs/05 §9.2）
# ======================================================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# 限流配置（docs/05 §11.2）
# LLM_RPM_LIMIT=500               # 每分钟最大请求数
# LLM_TPM_LIMIT=100000            # 每分钟最大 Token 数

# ======================================================================
# Celery 配置（异步任务队列，批量生成 + 嵌入计算）
# ======================================================================
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ======================================================================
# 可观测性配置（LangFuse 全链路追踪，docs/05 §7）
# ======================================================================
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
