# ============================================================================
# AI-Test-Gen 根目录 .gitignore
# ============================================================================
# 排除运行时生成的数据、日志、密钥、环境变量等敏感或可重生成的文件
# 避免敏感数据泄露和仓库膨胀

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ===== 虚拟环境 =====
.venv/
venv/
env/
ENV/

# ===== Node.js（前端） =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ===== 数据持久化目录（Docker 绑定挂载，含敏感数据） =====
# PostgreSQL 数据 + Milvus 向量库 + Fernet 加密密钥
data/
# 本地开发时 backend/data 也排除（与 Docker 挂载的 ./data 同源）
backend/data/
# 日志文件
logs/
backend/logs/
# Milvus 运行时数据（etcd + MinIO + Milvus 存储 + 模型缓存）
milvus/

# ===== 环境变量（含 API Key 等敏感信息） =====
.env
.env.local
.env.*.local
backend/.env
# v2.8.60: 主密钥文件（LLM API Key 加密密钥，泄露会导致数据库中加密的 API Key 被解密）
backend/.keys/
*.key
*.master.key

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*~

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 构建产物 =====
frontend/dist/
*.log

# ===== 临时文件 =====
*.tmp
*.bak
*.cache

# ===== 本地模型权重（大体积，不入库；使用说明见 models/README.md） =====
models/*/
backend/models/
!models/README.md

# ===== 临时分析报告 / 截图 / 工具缓存（不入库） =====
BUG_ANALYSIS_REPORT.md
REQ_FLOW_ALIGNMENT_REPORT.md
# 2026-10-30 根目录/backend 一次性脚本与产物归档（本地追溯用，不入库）
archive/scripts-2026-10/
*.png
.playwright-cli/
.workbuddy/
.workbuddy-ai/
# playwright 抓取的快照与登录态
auth.json
after-*.yaml
testcases-*.yaml
xmind-*.yaml
edit-dialog.yaml

# ===== 本地临时文件 / 历史离线包（不入库） =====
dy
ai-testgen-update-*.zip
# ===== 内网离线更新包（构建产物，不入库） =====
release/

# ===== 调试残留文件（防止再次入库） =====
# 一次性调试 dump / state / json
clarify_history.txt
clarify_state.txt
raw_text_dump.txt
srr_dump.txt
req_clarifications.json
req_detail.json
req_questions.json
# 一次性安装环境文件
install_*.env
# 根目录散落的一次性脚本（正式脚本应位于 backend/ 或 scripts/ 下）
/check_srr.py
/check_*.py
/test_*.py
/verify_*.py
/_*.py
# 根目录一次性批处理/进程文件与本地 token（Windows 侧验证脚手架）
/_*.cmd
/_*.pid
/_aitg_token.txt
# backend 下的一次性诊断/验证脚本、临时产物与 e2e 验证目录（不入库）
backend/_*.py
backend/verify_*.py
backend/check_*.py
backend/_e2e_tmp/
backend/artifacts/
backend/e2e_runner.py
backend/find_req.py
backend/questions_*.txt
backend/test_req_doc.md
backend/clarify_v1_1_results.json
# v3.0.0: 根目录下的一次性端到端验证目录（不入库）
_e2e_v30/
# v3.5.6: 同类一次性 E2E 验证目录（版本号后缀会变化，统一忽略）
_e2e_v*/
_e2e_v3*/
# v2.8.60: 根目录临时报告文件（应归档到 docs/ 或删除）
BUG_REPORT_*.md
SECURITY-AUDIT-REPORT.md
KB_MODEL_FIX_OVERVIEW.md
DEPLOY_OFFLINE_PACK.md

# ===== 根目录一次性验证目录（与 _e2e_v30/ 同类，不入库） =====
_e2e_tmp/
_verify_tmp/
# 端到端审阅台产物 + 无头浏览器 UI 验证脚手架（本地产物，不入库）
_review_runs/
_ui_tmp/

# ===== backend/tests 下的一次性探针脚本（不入库） =====
backend/tests/_probe_*.py
backend/tests/_e2e_*.py

# ===== 第三方工具本地副本（体积大、可重新下载，不入库） =====
# marktext 便携版（用于人工核对 xmind/markdown 导出效果）
tests/marktext-x64-win.zip
tests/marktext-x64-win/
_dogfood_tmp/
_calib_*.json
_calib_*.log
_acl_recovery/
_cleanup_log.txt
_cleanup_total.tmp
backend/tests/_verify_*.py
dsh-plugins-recommend.md
_dogfood_out/

# 部署时由 scripts/apply-resource-limits.sh 按宿主资源生成，属于环境产物
# （不同机器配额不同，提交进版本库会让别人误用你的内存值）
docker-compose.resources.override.yml

# 部署时由 deploy.sh 在安装目录生成的运行时记录（环境相关，不进版本库）
# - .deployed-version : 供下次部署做降级判断
# - DEPLOY-RECORD.md  : 本次部署的完整环境快照
.deployed-version
DEPLOY-RECORD.md
