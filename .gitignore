# ============================================================================
# AI-Test-Gen 根目录 .gitignore
# ============================================================================
# 排除运行时生成的数据、日志、密钥、环境变量等敏感或可重生成的文件
# 避免敏感数据泄露和仓库膨胀

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ===== 虚拟环境 =====
.venv/
venv/
env/
ENV/

# ===== Node.js（前端） =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ===== 数据持久化目录（Docker 绑定挂载，含敏感数据） =====
# PostgreSQL 数据 + Milvus 向量库 + Fernet 加密密钥
data/
# 本地开发时 backend/data 也排除（与 Docker 挂载的 ./data 同源）
backend/data/
# 日志文件
logs/
backend/logs/
# Milvus 运行时数据（etcd + MinIO + Milvus 存储 + 模型缓存）
milvus/

# ===== 环境变量（含 API Key 等敏感信息） =====
.env
.env.local
.env.*.local
backend/.env
# v2.8.60: 主密钥文件（LLM API Key 加密密钥，泄露会导致数据库中加密的 API Key 被解密）
backend/.keys/
*.key
*.master.key

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*~

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 构建产物 =====
frontend/dist/
*.log

# ===== 临时文件 =====
*.tmp
*.bak
*.cache

# ===== 本地模型权重（大体积，不入库；使用说明见 models/README.md） =====
models/*/
backend/models/
!models/README.md

# ===== 临时分析报告 / 截图 / 工具缓存（不入库） =====
BUG_ANALYSIS_REPORT.md
REQ_FLOW_ALIGNMENT_REPORT.md
*.png
.playwright-cli/
.workbuddy/
# playwright 抓取的快照与登录态
auth.json
after-*.yaml
testcases-*.yaml
xmind-*.yaml
edit-dialog.yaml

# ===== 本地临时文件 / 历史离线包（不入库） =====
dy
ai-testgen-update-*.zip
# ===== 内网离线更新包（构建产物，不入库） =====
release/

# ===== 调试残留文件（防止再次入库） =====
# 一次性调试 dump / state / json
clarify_history.txt
clarify_state.txt
raw_text_dump.txt
srr_dump.txt
req_clarifications.json
req_detail.json
req_questions.json
# 一次性安装环境文件
install_*.env
# 根目录散落的一次性脚本（正式脚本应位于 backend/ 或 scripts/ 下）
/check_srr.py
/check_*.py
/test_*.py
/verify_*.py
/_*.py
# backend 下的一次性诊断/验证脚本、临时产物与 e2e 验证目录（不入库）
backend/_*.py
backend/verify_*.py
backend/check_*.py
backend/_e2e_tmp/
backend/artifacts/
backend/e2e_runner.py
backend/find_req.py
backend/questions_*.txt
backend/test_req_doc.md
backend/clarify_v1_1_results.json
# v3.0.0: 根目录下的一次性端到端验证目录（不入库）
_e2e_v30/
# v2.8.60: 根目录临时报告文件（应归档到 docs/ 或删除）
BUG_REPORT_*.md
SECURITY-AUDIT-REPORT.md
KB_MODEL_FIX_OVERVIEW.md
DEPLOY_OFFLINE_PACK.md
